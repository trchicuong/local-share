# ==============================================================================
# Local Share (LoS) v3.1 Environment Configuration Template
# Copy this file to .env or set environment variables in Docker / systemd
# ==============================================================================

# Server Network Binding
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# WebSocket & Transfer Fallback
# When WebRTC P2P is blocked by restrictive symmetric NATs or enterprise firewalls,
# fallback to chunk streaming over WebSocket. Set to false to force P2P only.
WS_FALLBACK=true

# Debug Logging (Verbose transfer logs in terminal)
DEBUG_MODE=false

# Rate Limiting
# Protects signaling server against DoS/flooding attacks (requests per window)
# Set to 'true' for default (5 req/sec), or set a specific number, or 'false' to disable.
RATE_LIMIT=true

# Connection Limits
MAX_CONNECTIONS=200
HEARTBEAT_INTERVAL=20000
CONNECTION_TIMEOUT=35000

# Custom WebRTC ICE Servers (STUN / TURN)
# By default, public Google & Twilio STUN servers are used automatically.
# To use your own self-hosted Coturn or Twilio TURN credentials, pass a JSON string
# or path to a JSON file containing the iceServers array:
# RTC_CONFIG=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-turn.com:3478","username":"user","credential":"password"}]

