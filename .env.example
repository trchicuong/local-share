# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Client Configuration (Vite prefix required)
VITE_SIGNALING_SERVER_URL=ws://localhost:8080
# VITE_SIGNALING_SERVER_URL=wss://wss.trchicuong.id.vn

# Server Settings
HEARTBEAT_INTERVAL=30000
CONNECTION_TIMEOUT=300000
CORS_ORIGIN=*
# Production: Set specific domains for CORS
# Example: CORS_ORIGIN=https://yourdomain.com
FRONTEND_URL=http://localhost:5173
# PRODUCTION_URL=https://yourdomain.com

# Security & Performance
MAX_CONNECTIONS=100
MAX_MESSAGE_SIZE=1048576
WS_MESSAGE_RATE_LIMIT=30
WS_MESSAGE_RATE_WINDOW=10000

# Memory Management
MEMORY_WARNING_THRESHOLD=419430400
MEMORY_CRITICAL_THRESHOLD=524288000

# Validation Limits
MAX_JSON_DEPTH=5
MAX_STRING_LENGTH=10000
MAX_ARRAY_LENGTH=100

# Room Management
ROOM_CLEANUP_INTERVAL=300000
MAX_ROOM_SIZE=10

# Logging
LOG_LEVEL=info
# Options: error, warn, info, debug

# ========================================
# PRODUCTION SECURITY CHECKLIST:
# ========================================
# 1. Set NODE_ENV=production
# 2. Replace CORS_ORIGIN=* with specific domain(s)
# 3. Set FRONTEND_URL and PRODUCTION_URL
# 4. Use WSS (secure WebSocket) instead of WS
# 5. Enable HTTPS with valid SSL certificate
# 6. Run with: node --expose-gc server.js (for better memory management)
# 7. Set up reverse proxy (nginx/Apache) with rate limiting
# 8. Monitor server logs and metrics
# 9. Implement IP whitelisting if needed
# 10. Enable firewall rules

# Example Production Config:
# NODE_ENV=production
# VITE_SIGNALING_SERVER_URL=wss://yourdomain.com
# CORS_ORIGIN=https://yourdomain.com
# FRONTEND_URL=https://yourdomain.com
# PRODUCTION_URL=https://yourdomain.com
