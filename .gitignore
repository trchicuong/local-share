# ==========================================
# Local Share (LoS) - Production .gitignore
# ==========================================

# Dependencies
node_modules/
.pnpm-store/
.npm/

# Build outputs
dist/
build/
dev-dist/

# Vite caches & build timestamp artifacts
.vite/
vite.config.*.timestamp-*

# Environment variables & secrets (NEVER commit!)
.env
.env.*
!.env.example
!.env.*.example

# SSL Certificates & Private Keys (Local HTTPS / WebRTC testing)
*.pem
*.key
*.crt
*.pfx
*.csr
*.cer

# Logs & Debuggers
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# PM2 Process Manager
.pm2/
pm2.log

# Docker overrides & local volumes
docker-compose.override.yml
.docker/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Test & Code Coverage
coverage/
.nyc_output/

# Temporary files & Backups
*.tmp
tmp/
temp/
*.bak
*.backup
server.js.backup.*

temp/
*.bak
*.backup
server.js.backup.*